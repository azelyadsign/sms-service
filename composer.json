{
    "name": "azelya/sms-service",
    "description": "Azelya SMS Service — PHP SDK for the Azelya SMS Gateway API. Send SMS, track delivery status, manage devices, and authenticate from any PHP application.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sms",
        "sms-gateway",
        "azelya",
        "laravel",
        "api-client"
    ],
    "authors": [
        {
            "name": "Azelya"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/support": "Enables the Laravel integration (service provider + facade)",
        "illuminate/cache": "Enables access token caching via the Laravel cache repository"
    },
    "autoload": {
        "psr-4": {
            "Azelya\\SmsService\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azelya\\SmsService\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Azelya\\SmsService\\Laravel\\SmsServiceProvider"
            ],
            "aliases": {
                "AzelyaSms": "Azelya\\SmsService\\Laravel\\Facades\\AzelyaSms"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
